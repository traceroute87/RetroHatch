<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- download the signed catalog's APKs over HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- standard PackageInstaller sessions: the user still confirms every install in Android's own screen, and must allow RetroHatch under "Install unknown apps" -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Package visibility without QUERY_ALL_PACKAGES. Tested on Android 12 (API 31): an installer is NOT automatically allowed to see the app it installed, so
      "Installed" / "Open" need an explicit rule. Catalog package names are not known at build time, so <package> entries are impossible; the narrowest
      declaration that works is: packages that have a launcher activity (what a user sees as an app). Non-launchable packages stay invisible.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="RetroHatch"
        android:theme="@style/Theme.RetroHatch">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".android.InstallResultReceiver" android:exported="false" />
    </application>
</manifest>
