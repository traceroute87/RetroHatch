{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroHatch device profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "adapter", "package_format", "firmware"],
  "properties": {
    "schema": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["opk-funkeyos", "android-packageinstaller"], "description": "Install adapter. Many profiles may share one adapter."},
    "package_format": {"enum": ["opk", "apk"]},
    "display": {"type": "object", "additionalProperties": false, "required": ["w", "h"],
      "properties": {"w": {"type": "integer"}, "h": {"type": "integer"}}},
    "firmware": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "description": "Firmware profile ids selectable on this device."},
    "notes": {"type": "string"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}}
}
