{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroHatch app entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "description", "developer", "source", "license", "category", "artifacts"],
  "properties": {
    "schema": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "long_description": {"type": "string", "minLength": 1, "maxLength": 2000, "description": "ANDROID CLIENT ONLY. Paragraphs separated by a blank line. The RG Nano verifier (core/rh_catalog.c) rejects unknown app fields, so tools/trust.py refuses to sign an index that carries this."},
    "features": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 120}, "description": "ANDROID CLIENT ONLY, same rule as long_description."},
    "developer": {"type": "string", "minLength": 1},
    "website": {"$ref": "#/$defs/https"},
    "source": {"$ref": "#/$defs/https"},
    "license": {"type": "string", "minLength": 1, "description": "SPDX id, or the literal \"unknown\". Unknown license => no artifact may be available."},
    "category": {"enum": ["application", "utility", "launcher", "theme", "port", "other"]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "https": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "firmware", "format", "status", "compatibility"],
      "properties": {
        "device": {"$ref": "#/$defs/id"},
        "firmware": {"$ref": "#/$defs/id"},
        "format": {"enum": ["opk", "apk"]},
        "status": {"enum": ["available", "unavailable"], "description": "Only \"available\" artifacts can be offered for install."},
        "unavailable_reason": {"type": "string"},
        "version": {"type": "string"},
        "url": {"$ref": "#/$defs/https"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "android": {"type": "object", "additionalProperties": false, "required": ["package", "version_code", "signer_sha256"],
          "description": "APK identity, only for format apk: package name, versionCode, and the SHA-256 of the signing certificate(s) the APK must carry. The APK file hash is the artifact sha256.",
          "properties": {
            "package": {"type": "string", "maxLength": 255, "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"},
            "version_code": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "signer_sha256": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}}},
        "install": {"type": "object", "additionalProperties": false,
          "properties": {"dest_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}}},
        "compatibility": {
          "type": "object", "additionalProperties": false, "required": ["level"],
          "properties": {
            "level": {"enum": ["verified", "community", "experimental", "unsupported", "untested"]},
            "evidence": {"type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["sha256", "date", "tester"],
              "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "tester": {"type": "string"}, "note": {"type": "string"}}}}
          }
        }
      }
    }
  }
}
